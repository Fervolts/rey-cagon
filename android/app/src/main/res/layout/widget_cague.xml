<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_boton"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/widget_circulo"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Cagué"
            android:src="@drawable/widget_poop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/widget_cague"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_estado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_etiqueta"
        android:letterSpacing="0.1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/widget_hoy_cero"
        android:textColor="#171513"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
