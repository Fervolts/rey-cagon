<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rk_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/rk_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="RANKING · SEMANA"
        android:textColor="#5C5751"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rk_vacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Abre Rey Cagón para cargar el ranking"
        android:textColor="#171513"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/rk_fila0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_fila"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rk_pos0"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="#171513"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rk_nombre0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#171513"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rk_total0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textColor="#171513"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rk_fila1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_fila"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rk_pos1"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="#171513"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rk_nombre1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#171513"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rk_total1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textColor="#171513"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rk_fila2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_fila"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rk_pos2"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="#171513"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rk_nombre2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#171513"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rk_total2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textColor="#171513"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
